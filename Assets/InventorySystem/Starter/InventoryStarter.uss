/* Starter look for the InventoryUI prefab. Replace or restyle freely:
   InventoryCore.uss owns the functional rules, this sheet only sets the look. */

.starter-inventory-panel {
    position: absolute;
    align-self: center;
    width: 60%;
    height: 85%;
    margin-top: 40px;
    background-color: rgba(20, 20, 24, 0.95);
    border-top-left-radius: 12px;
    border-top-right-radius: 12px;
    border-bottom-right-radius: 12px;
    border-bottom-left-radius: 12px;
    padding-top: 10px;
    padding-left: 16px;
    padding-right: 16px;
    padding-bottom: 16px;
}

.starter-title {
    color: rgb(220, 220, 220);
    font-size: 20px;
    -unity-text-align: middle-center;
    margin-bottom: 8px;
}

.starter-equipment-row {
    flex-direction: row;
    justify-content: center;
    height: 110px;
    margin-bottom: 8px;
}

.starter-equip-slot {
    width: 96px;
    height: 96px;
    margin-left: 8px;
    margin-right: 8px;
}

.starter-tabs-row {
    flex-direction: row;
    justify-content: center;
    height: 56px;
    margin-bottom: 8px;
}

.starter-content {
    flex-grow: 1;
}

.inventory-slots-container {
    justify-content: flex-start;
    align-items: flex-start;
    padding: 8px;
    background-color: rgba(0, 0, 0, 0.25);
}

.inventorySlots {
    background-color: rgba(30, 30, 30, 0.85);
    border-left-color: rgba(90, 90, 90, 0.8);
    border-right-color: rgba(90, 90, 90, 0.8);
    border-top-color: rgba(90, 90, 90, 0.8);
    border-bottom-color: rgba(90, 90, 90, 0.8);
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    border-bottom-right-radius: 4px;
    border-bottom-left-radius: 4px;
}

.equipment-slot {
    background-color: rgba(30, 30, 30, 0.85);
    border-left-color: rgba(120, 120, 120, 0.8);
    border-right-color: rgba(120, 120, 120, 0.8);
    border-top-color: rgba(120, 120, 120, 0.8);
    border-bottom-color: rgba(120, 120, 120, 0.8);
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
}

.inventoryTab {
    min-width: 88px;
    height: 40px;
    margin-left: 4px;
    margin-right: 4px;
    background-color: rgba(30, 30, 30, 0.85);
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    border-bottom-right-radius: 4px;
    border-bottom-left-radius: 4px;
}

.inventoryTab--active {
    background-color: rgba(248, 163, 46, 0.25);
}

.equipment-slot-bg,
.inventoryTab-bg,
.inventoryTab-bg--active {
    -unity-background-scale-mode: scale-to-fit;
}

.inventoryTab-label {
    flex-grow: 1;
    color: rgb(220, 220, 220);
    font-size: 16px;
    -unity-text-align: middle-center;
}
