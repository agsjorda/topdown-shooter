.demo-inventory-panel {
    position: absolute;
    align-self: center;
    width: 60%;
    height: 85%;
    margin-top: 40px;
    background-color: rgba(20, 20, 24, 0.95);
    border-top-left-radius: 12px;
    border-top-right-radius: 12px;
    border-bottom-right-radius: 12px;
    border-bottom-left-radius: 12px;
    padding-top: 10px;
    padding-left: 16px;
    padding-right: 16px;
    padding-bottom: 16px;
}

.demo-title {
    color: rgb(220, 220, 220);
    font-size: 18px;
    -unity-text-align: middle-center;
    margin-bottom: 8px;
    white-space: normal;
}

.demo-equipment-row {
    flex-direction: row;
    justify-content: center;
    height: 110px;
    margin-bottom: 8px;
}

.demo-equip-slot {
    width: 96px;
    height: 96px;
    margin-left: 8px;
    margin-right: 8px;
}

.demo-tabs-row {
    flex-direction: row;
    justify-content: center;
    height: 56px;
    margin-bottom: 8px;
}

.demo-content {
    flex-grow: 1;
}

/* --- Demo look for slots/tabs (the core module sheet is functional-only;
       each game styles these classes itself, like GameUI.uss does in the shooter) --- */

.inventory-slots-container {
    justify-content: center;
    align-items: flex-start;
    padding: 8px;
    background-color: rgba(0, 0, 0, 0.25);
}

.inventorySlots {
    background-color: rgba(30, 30, 30, 0.85);
    border-left-color: rgba(90, 90, 90, 0.8);
    border-right-color: rgba(90, 90, 90, 0.8);
    border-top-color: rgba(90, 90, 90, 0.8);
    border-bottom-color: rgba(90, 90, 90, 0.8);
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    border-bottom-right-radius: 4px;
    border-bottom-left-radius: 4px;
}

.equipment-slot {
    background-color: rgba(30, 30, 30, 0.85);
    border-left-color: rgba(120, 120, 120, 0.8);
    border-right-color: rgba(120, 120, 120, 0.8);
    border-top-color: rgba(120, 120, 120, 0.8);
    border-bottom-color: rgba(120, 120, 120, 0.8);
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
}

.inventoryTab--active {
    background-color: rgba(248, 163, 46, 0.25);
}
