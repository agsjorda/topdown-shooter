.healthBar_fill {
    flex-grow: 0;
    background-position-x: left 0;
    width: 99%;
    background-color: rgb(248, 163, 46);
    height: 80%;
    background-image: none;
    flex-shrink: 0;
    overflow: visible;
    margin-right: 5px;
    -unity-background-scale-mode: scale-to-fit;
    border-bottom-right-radius: 20px;
    border-top-right-radius: 20px;
    margin-top: 5px;
    margin-bottom: 5px;
    margin-left: 5px;
    padding-top: 0;
    padding-right: 0;
    padding-bottom: 0;
    padding-left: 0;
    align-self: auto;
    align-items: flex-start;
    align-content: flex-start;
}

.healthBar_fill:hover {
    background-color: rgb(255, 169, 45);
}

.quickSlot {
    flex-grow: 0;
    width: 5%;
    height: 100%;
    background-color: rgba(34, 34, 34, 0.8);
    flex-shrink: 0;
    margin-top: 15px;
    margin-right: 15px;
    margin-bottom: 15px;
    margin-left: 15px;
    padding-top: 10px;
    padding-right: 10px;
    padding-bottom: 10px;
    padding-left: 10px;
    background-image: none;
    border-top-width: 5px;
    border-right-width: 5px;
    border-bottom-width: 5px;
    border-left-width: 5px;
    border-left-color: rgba(250, 247, 247, 0.57);
    border-right-color: rgba(250, 247, 247, 0.57);
    border-top-color: rgba(250, 247, 247, 0.57);
    border-bottom-color: rgba(250, 247, 247, 0.57);
    border-top-left-radius: 20px;
    border-top-right-radius: 20px;
    border-bottom-right-radius: 20px;
    border-bottom-left-radius: 20px;
    cursor: initial;
    opacity: 1;
    overflow: visible;
    box-shadow: 0 4px 100px rgba(0, 0, 0, 0.6);
}

.quickSlot:hover {
    scale: 1.05 1.05;
    transition-duration: 0.5s;
    transition-timing-function: ease-in-out;
    cursor: initial;
    rotate: 5deg;
}

.minimap {
    flex-grow: 0;
    flex-shrink: 0;
    width: 15%;
    height: 30%;
    margin-top: 100px;
    margin-right: 100px;
    margin-bottom: 100px;
    margin-left: 100px;
    background-color: rgba(0, 0, 0, 0.75);
    border-top-left-radius: 50px;
    border-top-right-radius: 50px;
    border-bottom-right-radius: 50px;
    border-bottom-left-radius: 50px;
    border-top-width: 5px;
    border-right-width: 5px;
    border-bottom-width: 5px;
    border-left-width: 5px;
    border-left-color: rgba(255, 255, 255, 0.69);
    border-right-color: rgba(255, 255, 255, 0.69);
    border-top-color: rgba(255, 255, 255, 0.69);
    border-bottom-color: rgba(255, 255, 255, 0.69);
    background-image: url("project://database/Assets/Textures/minimap_renderTexture.renderTexture?fileID=8400000&guid=920eedbff18111a4b82465479e7c2263&type=2#minimap_renderTexture");
}

.minimap:hover {
    flex-grow: 0;
    flex-shrink: 0;
    width: 15%;
    height: 30%;
    margin-top: 100px;
    margin-right: 100px;
    margin-bottom: 100px;
    margin-left: 100px;
    background-color: rgba(0, 0, 0, 0.75);
    border-top-left-radius: 50px;
    border-top-right-radius: 50px;
    border-bottom-right-radius: 50px;
    border-bottom-left-radius: 50px;
    border-top-width: 10px;
    border-right-width: 10px;
    border-bottom-width: 10px;
    border-left-width: 10px;
    border-left-color: rgba(241, 174, 8, 0.91);
    border-right-color: rgba(241, 174, 8, 0.91);
    border-top-color: rgba(241, 174, 8, 0.91);
    border-bottom-color: rgba(241, 174, 8, 0.91);
    transition-duration: 0.3s;
}


.inventory-slots-container {
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: space-around;
    align-items: flex-start;
    padding: 10px;
    gap: 8px;
    border: 10px solid rgb(102, 102, 102);
}

.inventorySlots {
    flex-shrink: 0;
    width: 250px;
    height: 250px;
    background-color: rgba(34, 34, 34, 0.4);
    border: 5px solid rgb(102, 102, 102);
    border-radius: 5px;
    justify-content: center;
    align-items: center;
    display: flex;
}

/* Ensure hover visuals are applied either by :hover or the code-toggled class */
.inventorySlots:hover,
.inventorySlots.inventorySlots--hover {
    transform: scale(1.02);
    transition-duration: 0.2s;
    transition-timing-function: ease-in-out;
    background-color: rgba(34, 34, 34, 0.7);
    border-top-width: 2px;
    border-right-width: 2px;
    border-bottom-width: 2px;
    border-left-width: 2px;
}

/* Hover border color is driven by the preset class from the inspector */
.inventorySlots.border-yellow:hover,
.inventorySlots.inventorySlots--hover.border-yellow { border-color: rgb(248, 163, 46); }

.inventorySlots.border-red:hover,
.inventorySlots.inventorySlots--hover.border-red { border-color: rgb(220, 80, 80); }

.inventorySlots.border-green:hover,
.inventorySlots.inventorySlots--hover.border-green { border-color: rgb(100, 200, 120); }

.inventoryTab {
    background-color: rgba(0, 0, 0, 0);
    border-bottom-width: 2px;
    border-bottom-color: rgb(102, 102, 102);
    width: 15%;
    height: 80%;
    justify-content: center;
    align-items: center;
    cursor: pointer;
    transition-duration: 0.2s;
    transition-timing-function: ease-in-out;
    padding-top: 20px;
    padding-bottom: 20px;
    padding-right: 20px;
    padding-left: 20px;
}

.inventoryTab-icon {
    width: 70%;
    height: 70%;
    background-size: contain;
    background-repeat: no-repeat;
    background-position: center;
    -unity-background-image-tint-color: rgb(178, 178, 178);
    transition-duration: 0.2s;
    transition-timing-function: ease-in-out;
}

.inventoryTab--active {
    border-bottom-width: 4px;
    border-bottom-color: rgb(248, 163, 46);
}

.inventoryTab--active .inventoryTab-icon {
    -unity-background-image-tint-color: rgb(248, 163, 46);
}

.inventoryTab:hover {
    background-color: rgba(34, 34, 34, 0.4);
}

.inventoryTab:hover .inventoryTab-icon {
    scale: 1.05 1.05;
}

.equipSlots {
    flex-grow: 1;
    position: absolute;
    top: 224px;
    left: 265px;
    height: 200px;
    width: 200px;
    rotate: 45deg;
    background-image: none;
    background-color: rgba(0, 0, 0, 0.2);
    border-left-color: rgba(236, 226, 226, 0.56);
    border-right-color: rgba(236, 226, 226, 0.56);
    border-top-color: rgba(236, 226, 226, 0.56);
    border-bottom-color: rgba(236, 226, 226, 0.56);
    border-top-width: 2px;
    border-right-width: 2px;
    border-bottom-width: 2px;
    border-left-width: 2px;
    border-top-left-radius: 10px;
    border-top-right-radius: 10px;
    border-bottom-right-radius: 10px;
    border-bottom-left-radius: 10px;
}

.equipSlots:hover {
    scale: 1.05 1.05 1.05;
    border-left-color: rgb(248, 163, 46);
    border-right-color: rgb(248, 163, 46);
    border-top-color: rgb(248, 163, 46);
    border-bottom-color: rgb(248, 163, 46);
    border-top-width: 2px;
    border-right-width: 2px;
    border-bottom-width: 2px;
    border-left-width: 2px;
    background-color: rgba(34, 34, 34, 0.7);
}

.equipSlot-icon {
    flex-grow: 1;
    width: 100%;
    height: auto;
    background-image: url("project://database/Assets/UI/icons/crossed-swords.png?fileID=2800000&guid=3fed58a9305314544922e12c854af2d0&type=3#crossed-swords");
    rotate: -45deg;
    position: relative;
    -unity-background-image-tint-color: rgb(178, 178, 178);
    background-size: 100% 100%;
    scale: 0.8 0.8;
}

.equipSlot-icon:hover {
    scale: 0.9 0.9;
}

