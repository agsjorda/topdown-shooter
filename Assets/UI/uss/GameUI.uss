.healthBar_fill {
    flex-grow: 0;
    background-position-x: left 0;
    width: 99%;
    background-color: rgb(248, 163, 46);
    height: 80%;
    background-image: none;
    flex-shrink: 0;
    overflow: visible;
    margin-right: 5px;
    -unity-background-scale-mode: scale-to-fit;
    border-bottom-right-radius: 20px;
    border-top-right-radius: 20px;
    margin-top: 5px;
    margin-bottom: 5px;
    margin-left: 5px;
    padding-top: 0;
    padding-right: 0;
    padding-bottom: 0;
    padding-left: 0;
    align-self: auto;
    align-items: flex-start;
    align-content: flex-start;
}

.healthBar_fill:hover {
    background-color: rgb(255, 169, 45);
}

.quickSlot {
    flex-grow: 0;
    width: 5%;
    height: 100%;
    background-color: rgba(34, 34, 34, 0.8);
    flex-shrink: 0;
    margin-top: 15px;
    margin-right: 15px;
    margin-bottom: 15px;
    margin-left: 15px;
    padding-top: 10px;
    padding-right: 10px;
    padding-bottom: 10px;
    padding-left: 10px;
    background-image: none;
    border-top-width: 5px;
    border-right-width: 5px;
    border-bottom-width: 5px;
    border-left-width: 5px;
    border-left-color: rgba(250, 247, 247, 0.57);
    border-right-color: rgba(250, 247, 247, 0.57);
    border-top-color: rgba(250, 247, 247, 0.57);
    border-bottom-color: rgba(250, 247, 247, 0.57);
    border-top-left-radius: 20px;
    border-top-right-radius: 20px;
    border-bottom-right-radius: 20px;
    border-bottom-left-radius: 20px;
    cursor: initial;
    opacity: 1;
    overflow: visible;
    box-shadow: 0 4px 100px rgba(0, 0, 0, 0.6);
}

.quickSlot:hover {
    scale: 1.05 1.05;
    transition-duration: 0.5s;
    transition-timing-function: ease-in-out;
    cursor: initial;
    rotate: 5deg;
}

.minimap {
    flex-grow: 0;
    flex-shrink: 0;
    width: 15%;
    height: 30%;
    margin-top: 100px;
    margin-right: 100px;
    margin-bottom: 100px;
    margin-left: 100px;
    background-color: rgba(0, 0, 0, 0.75);
    border-top-left-radius: 50px;
    border-top-right-radius: 50px;
    border-bottom-right-radius: 50px;
    border-bottom-left-radius: 50px;
    border-top-width: 5px;
    border-right-width: 5px;
    border-bottom-width: 5px;
    border-left-width: 5px;
    border-left-color: rgba(255, 255, 255, 0.69);
    border-right-color: rgba(255, 255, 255, 0.69);
    border-top-color: rgba(255, 255, 255, 0.69);
    border-bottom-color: rgba(255, 255, 255, 0.69);
    background-image: url("project://database/Assets/Textures/minimap_renderTexture.renderTexture?fileID=8400000&guid=920eedbff18111a4b82465479e7c2263&type=2#minimap_renderTexture");
}

.minimap:hover {
    flex-grow: 0;
    flex-shrink: 0;
    width: 15%;
    height: 30%;
    margin-top: 100px;
    margin-right: 100px;
    margin-bottom: 100px;
    margin-left: 100px;
    background-color: rgba(0, 0, 0, 0.75);
    border-top-left-radius: 50px;
    border-top-right-radius: 50px;
    border-bottom-right-radius: 50px;
    border-bottom-left-radius: 50px;
    border-top-width: 10px;
    border-right-width: 10px;
    border-bottom-width: 10px;
    border-left-width: 10px;
    border-left-color: rgba(241, 174, 8, 0.91);
    border-right-color: rgba(241, 174, 8, 0.91);
    border-top-color: rgba(241, 174, 8, 0.91);
    border-bottom-color: rgba(241, 174, 8, 0.91);
    transition-duration: 0.3s;
}

/* ------------Inventory Tabs Styling------------- */
.inventoryTab {
    background-color: rgba(0, 0, 0, 0);
    border-bottom-width: 2px;
    border-bottom-color: rgb(102, 102, 102);
    width: 15%;
    height: 80%;
    justify-content: center;
    align-items: center;
    cursor: pointer;
    transition-duration: 0.2s;
    transition-timing-function: ease-in-out;
    padding-top: 20px;
    padding-bottom: 20px;
    padding-right: 20px;
    padding-left: 20px;
}

.inventoryTab-icon {
    width: 70%;
    height: 70%;
    background-size: contain;
    background-repeat: no-repeat;
    background-position: center;
    -unity-background-image-tint-color: rgb(178, 178, 178);
    transition-duration: 0.2s;
    transition-timing-function: ease-in-out;
}

.inventoryTab--active {
    border-bottom-width: 4px;
    border-bottom-color: rgb(248, 163, 46);
}

.inventoryTab--active .inventoryTab-icon {
    -unity-background-image-tint-color: rgb(248, 163, 46);
}

.inventoryTab:hover {
    background-color: rgba(34, 34, 34, 0.4);
}

.inventoryTab:hover .inventoryTab-icon {
    scale: 1.05 1.05;
}



/* ------------Inventory Slots Styling------------- */
.inventory-slots-container {
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: space-around;
    align-items: flex-start;
    padding: 10px;
    gap: 8px;
    background-color: rgba(0, 0, 0, 0.2);
    border-left-color: rgba(236, 226, 226, 0.56);
    border-right-color: rgba(236, 226, 226, 0.56);
    border-top-color: rgba(236, 226, 226, 0.56);
    border-bottom-color: rgba(236, 226, 226, 0.56);
    border-top-width: 10px;
    border-right-width: 10px;
    border-bottom-width: 10px;
    border-left-width: 10px;
    border-top-style: solid;
    border-right-style: solid;
    border-bottom-style: solid;
    border-left-style: solid;
}

/* ===== EXISTING SLOT STYLES (Keep these) ===== */
.inventorySlots {
    flex-shrink: 0;
    width: 250px;
    height: 250px;
    background-color: rgba(34, 34, 34, 0.4);
    border-left-width: 5px;
    border-right-width: 5px;
    border-top-width: 5px;
    border-bottom-width: 5px;
    background-color: rgba(0, 0, 0, 0.2);
    border-left-color: rgba(236, 226, 226, 0.56);
    border-right-color: rgba(236, 226, 226, 0.56);
    border-top-color: rgba(236, 226, 226, 0.56);
    border-bottom-color: rgba(236, 226, 226, 0.56);
    border-radius: 5px;
    justify-content: center;
    align-items: center;
    display: flex;
}

.inventorySlots-icon {
    padding: 15px;
    flex-shrink: 0;
    flex-grow: 1;
}

.inventorySlots:hover {
    scale: 1.02 1.02 1.02;
    border-left-color: rgb(248, 163, 46);
    border-right-color: rgb(248, 163, 46);
    border-top-color: rgb(248, 163, 46);
    border-bottom-color: rgb(248, 163, 46);
    border-top-width: 2px;
    border-right-width: 2px;
    border-bottom-width: 2px;
    border-left-width: 2px;
    background-color: rgba(34, 34, 34, 0.7);
}

/* ============================
   DRAG & DROP SLOT STATES
   ============================ */

/* Slot being dragged */
.inventorySlots--dragging {
    opacity: 0.3;
    border-left-color: rgba(248, 163, 46, 0.5);
    border-right-color: rgba(248, 163, 46, 0.5);
    border-top-color: rgba(248, 163, 46, 0.5);
    border-bottom-color: rgba(248, 163, 46, 0.5);
}

/* Empty slot you are hovering over */
.inventorySlots--empty-highlight {
    border-left-color: rgba(0, 255, 100, 0.5);
    border-right-color: rgba(0, 255, 100, 0.5);
    border-top-color: rgba(0, 255, 100, 0.5);
    border-bottom-color: rgba(0, 255, 100, 0.5);
    border-top-width: 3px;
    border-right-width: 3px;
    border-bottom-width: 3px;
    border-left-width: 3px;
    background-color: rgba(0, 50, 0, 0.2);
}

/* Valid drop target */
.inventorySlots--drop-target {
    border-left-color: rgb(0, 255, 100);
    border-right-color: rgb(0, 255, 100);
    border-top-color: rgb(0, 255, 100);
    border-bottom-color: rgb(0, 255, 100);
    border-top-width: 4px;
    border-right-width: 4px;
    border-bottom-width: 4px;
    border-left-width: 4px;
    background-color: rgba(0, 50, 0, 0.3);
    scale: 1.05 1.05;
}

/* Shared transitions - match your working example */
.inventorySlots,
.inventorySlots--dragging,
.inventorySlots--empty-highlight,
.inventorySlots--drop-target {
    transition-property: 
        background-color,
        border-left-color,
        border-right-color,
        border-top-color,
        border-bottom-color,
        border-top-width,
        border-right-width,
        border-bottom-width,
        border-left-width,
        opacity,
        scale;
    transition-duration: 0.15s;
    transition-timing-function: ease-in-out;
}

/* ============================
   DRAG GHOST ELEMENT
   ============================ */

.drag-ghost {
    position: absolute;
    width: 128px;
    height: 128px;
    visibility: hidden;
    opacity: 0;
    pointer-events: none;
    border-left-color: rgba(248, 163, 46, 0.7);
    border-right-color: rgba(248, 163, 46, 0.7);
    border-top-color: rgba(248, 163, 46, 0.7);
    border-bottom-color: rgba(248, 163, 46, 0.7);
    border-top-width: 2px;
    border-right-width: 2px;
    border-bottom-width: 2px;
    border-left-width: 2px;
    border-top-left-radius: 5px;
    border-top-right-radius: 5px;
    border-bottom-right-radius: 5px;
    border-bottom-left-radius: 5px;
    background-color: rgba(34, 34, 34, 0.8);
    z-index: 9999;
    -unity-background-scale-mode: scale-to-fit;
    transition-property: opacity, border-left-color, border-right-color, border-top-color, border-bottom-color, scale;
    transition-duration: 0.15s;
    transition-timing-function: ease-out;
}

.drag-ghost--visible {
    visibility: visible;
    opacity: 0.8;
}

.drag-ghost--over-empty {
    border-left-color: rgba(0, 255, 100, 0.7);
    border-right-color: rgba(0, 255, 100, 0.7);
    border-top-color: rgba(0, 255, 100, 0.7);
    border-bottom-color: rgba(0, 255, 100, 0.7);
    scale: 1.1 1.1;
}

.drag-ghost--over-occupied {
    border-left-color: rgba(255, 100, 100, 0.7);
    border-right-color: rgba(255, 100, 100, 0.7);
    border-top-color: rgba(255, 100, 100, 0.7);
    border-bottom-color: rgba(255, 100, 100, 0.7);
    scale: 1.05 1.05;
}

/* ============================
   EQUIPMENT SLOT STYLES
   ============================ */
.equipSlots {
    flex-grow: 1;
    position: absolute;
    top: 224px;
    left: 265px;
    height: 200px;
    width: 200px;
    rotate: 45deg; /* This rotates the entire slot container */
    background-image: none;
    background-color: rgba(0, 0, 0, 0.2);
    border-left-color: rgba(236, 226, 226, 0.56);
    border-right-color: rgba(236, 226, 226, 0.56);
    border-top-color: rgba(236, 226, 226, 0.56);
    border-bottom-color: rgba(236, 226, 226, 0.56);
    border-top-width: 2px;
    border-right-width: 2px;
    border-bottom-width: 2px;
    border-left-width: 2px;
    border-top-left-radius: 10px;
    border-top-right-radius: 10px;
    border-bottom-right-radius: 10px;
    border-bottom-left-radius: 10px;
}

/* Position variants for each slot */
.equipSlots--weapon {
    /* Default position */
}

.equipSlots--headgear {
    top: 224px;
    left: 1200px;
}

.equipSlots--armor {
    top: 812px;
    left: 265px;
}

.equipSlots--boots {
    top: 812px;
    left: 1200px;
    height: 188px;
    width: 192px;
}

.equipSlots:hover {
    scale: 1.05 1.05 1.05;
    border-left-color: rgb(248, 163, 46);
    border-right-color: rgb(248, 163, 46);
    border-top-color: rgb(248, 163, 46);
    border-bottom-color: rgb(248, 163, 46);
    border-top-width: 2px;
    border-right-width: 2px;
    border-bottom-width: 2px;
    border-left-width: 2px;
    background-color: rgba(34, 34, 34, 0.7);
}

/* Base equipment slot icon styling - the actual equipment slot element */
.equipSlot-icon {
    flex-grow: 1;
    width: 100%;
    height: 100%;
    rotate: -45deg; /* This counter-rotates the default icon back to normal */
    position: relative;
    -unity-background-image-tint-color: rgb(178, 178, 178);
    -unity-background-scale-mode: scale-to-fit;
    background-size: 100% 100%;
    scale: 0.8 0.8;
    transition-property: scale;
    transition-duration: 0.2s;
    transition-timing-function: ease-in-out;
}

/* Icon variants - only set the background image */
.equipSlot-icon--weapon {
    background-image: url("project://database/Assets/UI/icons/pistol-gun.png?fileID=2800000&guid=67946d87233370d40a32743df378e812&type=3#pistol-gun");
}

.equipSlot-icon--headgear {
    background-image: url("project://database/Assets/UI/icons/spartan-helmet.png?fileID=2800000&guid=b529bf87e379f584b8e09ca0590441e1&type=3#spartan-helmet");
}

.equipSlot-icon--armor {
    background-image: url("project://database/Assets/UI/icons/lamellar.png?fileID=2800000&guid=5f54be2900ebead41911aaa3560779c6&type=3#lamellar");
}

.equipSlot-icon--boots {
    background-image: url("project://database/Assets/UI/icons/boots.png?fileID=2800000&guid=b27836b0d8d48fe47affacaa720edbe1&type=3#boots");
}

.equipSlot-icon:hover {
    scale: 0.9 0.9;
}

/* Equipment slot wrapper styling */
.equipment-slot {
    position: relative;
}

.equipment-slot--weapon {
    border-left-color: rgba(229, 62, 62, 0.7) !important;
    border-right-color: rgba(229, 62, 62, 0.7) !important;
    border-top-color: rgba(229, 62, 62, 0.7) !important;
    border-bottom-color: rgba(229, 62, 62, 0.7) !important;
}

.equipment-slot--armor {
    border-left-color: rgba(49, 130, 206, 0.7) !important;
    border-right-color: rgba(49, 130, 206, 0.7) !important;
    border-top-color: rgba(49, 130, 206, 0.7) !important;
    border-bottom-color: rgba(49, 130, 206, 0.7) !important;
}

.equipment-slot--headgear {
    border-left-color: rgba(56, 161, 105, 0.7) !important;
    border-right-color: rgba(56, 161, 105, 0.7) !important;
    border-top-color: rgba(56, 161, 105, 0.7) !important;
    border-bottom-color: rgba(56, 161, 105, 0.7) !important;
}

.equipment-slot--boots {
    border-left-color: rgba(214, 158, 46, 0.7) !important;
    border-right-color: rgba(214, 158, 46, 0.7) !important;
    border-top-color: rgba(214, 158, 46, 0.7) !important;
    border-bottom-color: rgba(214, 158, 46, 0.7) !important;
}

/* Equipment item icon - shown when slot has an item */
/* NOTE: No rotation needed - parent (.equipSlot-icon) already has rotate: -45deg */
.equipment-icon {
    position: absolute;
    width: 100%;
    height: 100%;
    top: 0;
    left: 0;
    -unity-background-scale-mode: scale-to-fit;
    scale: 0.8 0.8;
    display: none;
}

/* Equipment slot drop target */
.equipment-slot.inventorySlots--drop-target {
    border-left-color: rgb(0, 255, 100) !important;
    border-right-color: rgb(0, 255, 100) !important;
    border-top-color: rgb(0, 255, 100) !important;
    border-bottom-color: rgb(0, 255, 100) !important;
    border-top-width: 4px !important;
    border-right-width: 4px !important;
    border-bottom-width: 4px !important;
    border-left-width: 4px !important;
    background-color: rgba(0, 50, 0, 0.3) !important;
    scale: 1.05 1.05 !important;
}